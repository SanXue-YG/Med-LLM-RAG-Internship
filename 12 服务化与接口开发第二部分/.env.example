# Stage 12 runtime env (compatible with stage-11 names).
# Copy to `.env` in this directory. Already-set process env wins (override=False).

# --- server ---
STAGE12_HOST=127.0.0.1
STAGE12_PORT=8000
# Aliases: STAGE11_HOST / STAGE11_PORT

# --- retrieval / pipeline (process-level; restart after change) ---
# sample | full
MED_RAG_RETRIEVAL_MODE=sample
# Aliases: STAGE12_RETRIEVAL_MODE / STAGE11_RETRIEVAL_MODE
STAGE12_PIPELINE_BACKEND=constrained10
# Alias: STAGE11_PIPELINE_BACKEND  (constrained10 | medical08)

# --- documents catalog (stage 3+) ---
# sample → Dataset/documents/sample/documents_sample.sqlite
# full   → Dataset/documents/full/documents_full.sqlite
STAGE12_DOCUMENTS_MODE=sample

# --- logs (shared with QACallLogger /stats/qa) ---
# Empty → <stage12>/outputs/logs
STAGE12_LOG_DIR=
# Alias: STAGE11_LOG_DIR

# --- sessions ---
STAGE12_SESSION_TTL=3600
STAGE12_SESSION_MAX_TURNS=10
# Aliases: STAGE11_SESSION_TTL / STAGE11_SESSION_MAX_TURNS

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# Optional Dataset root override (affects chroma / documents / bm25 paths)
# MED_RAG_DATASET_ROOT=
