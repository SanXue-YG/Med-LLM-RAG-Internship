# Stage 12 / compatible with stage 11
# Copy to .env and adjust. Already-set process env wins over these defaults.

STAGE12_HOST=127.0.0.1
STAGE12_PORT=8000

# sample | full  — process-level; restart after change
MED_RAG_RETRIEVAL_MODE=sample

# Documents catalog mode (stage 3+); default follows retrieval mode
STAGE12_DOCUMENTS_MODE=sample

STAGE12_PIPELINE_BACKEND=constrained10
STAGE12_LOG_DIR=

STAGE12_SESSION_TTL=3600
STAGE12_SESSION_MAX_TURNS=10

# Aliases also accepted: STAGE11_HOST / STAGE11_PORT / STAGE11_LOG_DIR / …

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b
