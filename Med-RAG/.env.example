# Med-RAG runtime env. Copy to `.env` in Med-RAG/ root.
# Already-set process env wins (override=False).

# --- server ---
MED_RAG_HOST=127.0.0.1
MED_RAG_PORT=8000

# --- retrieval / pipeline (restart after change) ---
# sample | full
MED_RAG_RETRIEVAL_MODE=sample
MED_RAG_PIPELINE_BACKEND=constrained10
MED_RAG_DOCUMENTS_MODE=sample

# --- CORS (Vite dev defaults) ---
MED_RAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# --- logs / chat ---
# Empty → Med-RAG/data/logs and Med-RAG/data/chat
MED_RAG_LOG_DIR=
MED_RAG_CHAT_DIR=
MED_RAG_SESSION_TTL=86400
MED_RAG_SESSION_MAX_TURNS=20

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# Optional data root override (default: <Med-RAG>/data)
# MED_RAG_DATASET_ROOT=
# MED_RAG_HOME=
